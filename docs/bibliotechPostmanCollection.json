{
  "info": {
    "name": "BiblioTech - Pruebas de API REST",
    "description": "Pruebas de autenticación, usuarios, libros, autores, préstamos, validaciones y errores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3700"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": "usuario.prueba@example.com"
    },
    {
      "key": "testPassword",
      "value": "Prueba123!"
    }
  ],
  "item": [
    {
      "name": "00 - Inicio y errores",
      "item": [
        {
          "name": "Ruta principal",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Error - ID de libro inválido",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/123"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde con error 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Error - Recurso inexistente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/507f1f77bcf86cd799439011"
          }
        },
        {
          "name": "Error - JSON inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"JSON inválido}"
            },
            "url": "{{baseUrl}}/api/books"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde con error 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario de Prueba\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro aceptado o correo duplicado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
                  "});",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set('userToken', data.token);",
                  "    if (data.user && data.user._id) pm.collectionVariables.set('userId', data.user._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicio de sesión correcto o credenciales rechazadas', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set('userToken', data.token);",
                  "    if (data.user && data.user._id) pm.collectionVariables.set('userId', data.user._id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Alternativo\",\n  \"email\": \"usuario.alternativo@example.com\",\n  \"password\": \"Prueba123!\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Listar usuarios - requiere ADMIN",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta de autorización esperada', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar rol - requiere ADMIN",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"USER\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/role"
          }
        }
      ]
    },
    {
      "name": "03 - Libros",
      "item": [
        {
          "name": "Listar libros",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books?page=1&limit=10"
          }
        },
        {
          "name": "Consultar libro por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "Crear libro - requiere ADMIN",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Libro de prueba Postman\",\n  \"isbn\": \"9781234567897\",\n  \"author\": \"{{authorId}}\",\n  \"genre\": \"novela\",\n  \"year\": 2024,\n  \"totalCopies\": 2\n}"
            },
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Error - ISBN duplicado",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Libro duplicado\",\n  \"isbn\": \"9780307474728\",\n  \"author\": \"{{authorId}}\",\n  \"genre\": \"novela\",\n  \"year\": 2024,\n  \"totalCopies\": 1\n}"
            },
            "url": "{{baseUrl}}/api/books"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ISBN duplicado devuelve 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Error - Campos inválidos",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"isbn\": \"123\",\n  \"author\": \"123\",\n  \"genre\": \"inventado\",\n  \"year\": 0,\n  \"totalCopies\": 0\n}"
            },
            "url": "{{baseUrl}}/api/books"
          }
        }
      ]
    },
    {
      "name": "04 - Autores",
      "item": [
        {
          "name": "Listar autores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors"
          }
        },
        {
          "name": "Crear autor",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Autor de prueba Postman\",\n  \"nationality\": \"Colombiana\",\n  \"birthYear\": 1980\n}"
            },
            "url": "{{baseUrl}}/api/authors"
          }
        },
        {
          "name": "Consultar autor por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/authors/{{authorId}}"
          }
        }
      ]
    },
    {
      "name": "05 - Préstamos",
      "item": [
        {
          "name": "Crear préstamo",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book\": \"{{bookId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/loans"
          }
        },
        {
          "name": "Listar préstamos - requiere ADMIN",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/loans"
          }
        },
        {
          "name": "Consultar préstamo por ID",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/loans/{{loanId}}"
          }
        },
        {
          "name": "Devolver préstamo",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/loans/{{loanId}}/return"
          }
        }
      ]
    },
    {
      "name": "06 - Autorización y errores",
      "item": [
        {
          "name": "401 - Usuarios sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sin token devuelve 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "403 - Usuario normal intenta listar usuarios",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario sin permisos recibe 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - Correo duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Duplicado\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Correo duplicado devuelve 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}